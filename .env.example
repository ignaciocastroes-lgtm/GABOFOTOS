# ── Mercado Pago ────────────────────────────────────────────────────────────
# Credenciales > Credenciales de producción > Access Token
# https://www.mercadopago.cl/developers/panel/app
# Empieza con APP_USR-. NUNCA lleva el prefijo NEXT_PUBLIC_.
MP_ACCESS_TOKEN=

# Firma del webhook, se genera en el panel al configurar la notificación de Pagos.
# Sin esto cualquiera puede falsificar avisos de pago.
MP_WEBHOOK_SECRET=

# ── Contacto ────────────────────────────────────────────────────────────────
# WhatsApp del club en formato 569XXXXXXXX (sin +, sin espacios, sin guiones).
# Ejemplo: 56912345678
# Mientras esté vacío, los botones de WhatsApp simplemente no se muestran
# y el sitio cae en el correo. No se rompe nada.
NEXT_PUBLIC_WHATSAPP=

# ── Sitio ───────────────────────────────────────────────────────────────────
# URL pública de producción, sin barra final. Mercado Pago la usa para volver.
NEXT_PUBLIC_SITE_URL=https://internacionalloespejo.cl

# ── Admin ───────────────────────────────────────────────────────────────────
# Contraseña de /admin, el panel de noticias. Sin comillas, sin espacios.
# Cambiarla acá cierra todas las sesiones abiertas al instante.
ADMIN_PASSWORD=

# ── Noticias (Supabase) ─────────────────────────────────────────────────────
# Proyecto propio del club — NO reutilizar el de Dondestanemo ni el de
# ningún otro proyecto. Crear uno gratis en supabase.com, correr
# supabase/schema.sql y supabase/seed.sql en su SQL Editor, y copiar acá:
#
# URL del proyecto (Settings → API → Project URL)
SUPABASE_URL=
# Service role key (Settings → API → Project API keys → service_role).
# Es una llave con permisos totales — nunca con el prefijo NEXT_PUBLIC_,
# nunca en un commit, nunca visible al navegador.
SUPABASE_SERVICE_ROLE_KEY=
