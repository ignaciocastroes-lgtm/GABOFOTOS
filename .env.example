# Variables de entorno (en Vercel: Project → Settings → Environment Variables)

# ── Sitio ───────────────────────────────────────────────────────────────────
# Dominio público, sin barra final. Se usa en el mapa del sitio, en los datos para buscadores
# y en los mensajes de WhatsApp de la galería.
NEXT_PUBLIC_SITE_URL=https://www.gabofotos.cl

# ── Panel de fotos (/admin) ─────────────────────────────────────────────────
# Contraseña de Gabo para entrar a /admin. Sin comillas ni espacios.
ADMIN_PASSWORD=
# Secreto para firmar las sesiones (cualquier texto largo y al azar; ej. `openssl rand -hex 32`).
# Cambiarlo cierra todas las sesiones abiertas. Si se deja vacío se usa ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# ── Supabase: base de datos y almacenamiento de las fotos ───────────────────
# Proyecto propio de GABOFOTOS. Crear uno gratis en supabase.com y correr supabase/schema.sql
# en su SQL Editor. Luego copiar:
#   Settings → API → Project URL
SUPABASE_URL=
#   Settings → API → llave secreta (service_role). Permisos totales: nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Flickr (opcional) ───────────────────────────────────────────────────────
# Si se define, además de las fotos del panel se muestran las de sus álbumes de Flickr.
# https://www.flickr.com/services/apps/create/
FLICKR_API_KEY=
# FLICKR_USER_ID=
